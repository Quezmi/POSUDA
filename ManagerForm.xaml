<Window x:Class="POSUDA.ManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSUDA"
        mc:Ignorable="d"
        Title="ManagerForm" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="85*"/>
            <ColumnDefinition Width="16*"/>
            <ColumnDefinition Width="234*"/>
            <ColumnDefinition Width="452*"/>
        </Grid.ColumnDefinitions>
        <Image HorizontalAlignment="Left" Height="100" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" Source="/logo.png" Grid.ColumnSpan="3"/>
        <Image
            Width="100" VerticalAlignment="Top" Source="/logo.png" Margin="10,10,0,0" Height="100" HorizontalAlignment="Left" Grid.ColumnSpan="3"/>
    </Grid>
</Window>
